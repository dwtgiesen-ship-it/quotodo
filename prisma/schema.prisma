// SalonFlow — local development schema (SQLite, zero external services).
// Production uses the Postgres + RLS schema in docs/salonflow/prisma/schema.prisma.
// SQLite has no native enums or scalar lists, so enum-ish fields are strings and
// list/JSON fields (serviceIds, tags) are stored as JSON strings. The app-layer
// TypeScript unions in src/app/salonflow/lib/types.ts constrain the values.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Salon {
  id                 String  @id @default(cuid())
  name               String
  slug               String  @unique
  vertical           String
  currency           String  @default("EUR")
  timezone           String  @default("Europe/Amsterdam")
  onboardingComplete Boolean @default(false)
  calendarConnected  Boolean @default(false)
  weeklyHours        String  @default("{}") // JSON { mon:[startMin,endMin]|null, ... }

  services        Service[]
  staff           Staff[]
  clients         Client[]
  appointments    Appointment[]
  membershipPlans MembershipPlan[]
  campaigns       Campaign[]
  waitlist        WaitlistEntry[]
}

model Service {
  id             String  @id @default(cuid())
  salonId        String
  salon          Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name           String
  category       String
  durationMin    Int
  priceMinor     Int
  depositMinor   Int?
  bookableOnline Boolean @default(true)
  sortOrder      Int     @default(0)

  appointments Appointment[]

  @@index([salonId])
}

model Staff {
  id             String  @id @default(cuid())
  salonId        String
  salon          Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name           String
  initials       String
  color          String  @default("#8B5FB8")
  role           String  @default("staff")
  bookableOnline Boolean @default(true)
  serviceIds     String  @default("[]") // JSON array of service ids
  weeklyHours    String  @default("{}") // JSON per-staff hours (overrides salon)
  archived       Boolean @default(false)

  appointments Appointment[]

  @@index([salonId])
}

model Client {
  id              String @id @default(cuid())
  salonId         String
  salon           Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)
  firstName       String
  lastName        String @default("")
  email           String @default("")
  phone           String @default("")
  notes           String @default("")
  since           String // ISO date (yyyy-mm-dd)
  totalSpendMinor Int    @default(0)
  loyaltyPoints   Int    @default(0)
  tier            String @default("standard")
  tags            String @default("[]") // JSON array
  profileType     String @default("generic") // pet | nail | generic
  profileData     String @default("{}") // JSON vertical profile

  appointments    Appointment[]
  memberships     MembershipUser[]
  loyaltyLedger   LoyaltyTransaction[]
  messages        Message[]
  photos          CustomerPhoto[]
  waitlist        WaitlistEntry[]

  @@index([salonId])
}

model Appointment {
  id        String   @id @default(cuid())
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  day       Int
  start     Float
  end       Float
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id])
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id])
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  status    String   @default("booked")
  source    String   @default("dashboard")
  isNew     Boolean  @default(false)
  starred   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([salonId, day])
  @@index([salonId, staffId, day])
  @@index([salonId, clientId])
}

model MembershipPlan {
  id                String  @id @default(cuid())
  salonId           String
  salon             Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name              String
  priceMinor        Int
  interval          String  @default("month") // month | year
  includedServices  String  @default("[]")    // JSON [{serviceId, quantity}]
  discountPct       Float   @default(0)
  loyaltyMultiplier Float   @default(1)
  active            Boolean @default(true)
  sortOrder         Int     @default(0)

  subscribers MembershipUser[]

  @@index([salonId])
}

model MembershipUser {
  id        String   @id @default(cuid())
  salonId   String
  planId    String
  plan      MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status    String   @default("active") // active | past_due | cancelled
  renewsAt  String?   // ISO date
  createdAt DateTime @default(now())

  @@index([salonId, clientId])
}

model LoyaltyTransaction {
  id        String   @id @default(cuid())
  salonId   String
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  delta     Int      // +earn / -redeem
  reason    String   // earn | redeem | referral | birthday | adjustment
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([salonId, clientId])
}

model Campaign {
  id               String  @id @default(cuid())
  salonId          String
  salon            Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  type             String  // confirmation | reminder | review | rebooking | birthday | win_back
  channel          String  // sms | email | whatsapp
  template         String
  triggerOffsetMin Int?
  active           Boolean @default(true)

  messages Message[]

  @@index([salonId])
}

model Message {
  id         String   @id @default(cuid())
  salonId    String
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  channel    String
  status     String   @default("sent") // queued | sent | delivered | read | failed
  body       String
  createdAt  DateTime @default(now())

  @@index([salonId, clientId])
}

model WaitlistEntry {
  id          String   @id @default(cuid())
  salonId     String
  salon       Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceId   String
  windowDay   Int      // preferred day index, -1 = any
  createdAt   DateTime @default(now())
  filledAt    DateTime?

  @@index([salonId])
}

model CustomerPhoto {
  id         String   @id @default(cuid())
  salonId    String
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  url        String
  kind       String   @default("reference") // before | after | reference
  createdAt  DateTime @default(now())

  @@index([salonId, clientId])
}
