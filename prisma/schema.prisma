// Kofferklaar — application schema (PostgreSQL).
//
// DATABASE_URL  — pooled connection string used at runtime.
// DIRECT_URL    — direct (non-pooled) connection for `prisma db push`.
//                 On Neon/Vercel Postgres set both; elsewhere use the same value.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// One piece of clothing (or shoes / accessory) from the wardrobe.
// The descriptive fields are filled in by Claude from the photo and can be
// corrected by hand; the stylist only ever sees these text fields.
model Item {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  name        String
  category    String // see CATEGORIES in src/lib/wardrobe.ts
  subcategory String   @default("")
  colors      String[]
  pattern     String   @default("")
  material    String   @default("")
  fit         String   @default("")
  formality   Int      @default(3) // 1 = sport/strand … 5 = gala
  warmth      Int      @default(3) // 1 = hittebestendig … 5 = winter
  styleTags   String[]
  description String   @default("")
  notes       String   @default("") // user's own notes ("zit krap", "alleen voor bruiloften")
  archived    Boolean  @default(false) // e.g. in de was / uitgeleend
  image       Bytes
  imageType   String   @default("image/jpeg")

  @@index([category])
}

// A stylist conversation. `messages` holds the raw Claude API history
// (user / assistant / tool blocks); the UI is rendered from it directly.
model Chat {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  title     String   @default("Nieuw gesprek")
  messages  Json     @default("[]")
}
