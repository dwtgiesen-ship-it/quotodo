# ────────────────────────────────────────────────────────────────────────
# DATABASE (required) — PostgreSQL. Easiest: a free Neon project (neon.tech).
#   DATABASE_URL  pooled connection (used at runtime)
#   DIRECT_URL    direct connection (used by `prisma db push` / migrations)
# On Neon/Supabase copy both from the dashboard. On a plain Postgres, set both
# to the same value. For local dev you can run `docker compose up -d` and use:
#   postgresql://schedulemode:schedulemode@localhost:5432/schedulemode
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/schedulemode?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/schedulemode?sslmode=require

# Supabase — only needed if you use the Supabase-backed quotes module (/quotes).
# Schedulemode (the salon app) does NOT require these.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Anthropic — optional. Without it the AI assistant falls back to rule-based.
# Get an API key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-your_key_here

# Resend (optional — required for "Send to Client" email feature)
# Sign up at https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=info@schedulemode.com

# App URL — used to build public share links.
# Local dev:   http://localhost:3000
# Production:  https://schedulemode.com (set this on the host)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ────────────────────────────────────────────────────────────────────────
# Schedulemode (/salonflow, /sf) — integrations below are ALL OPTIONAL.
# With none set, the app runs with mocked integrations: the AI assistant
# falls back to rule-based and calendar sync uses a mock provider.
# ────────────────────────────────────────────────────────────────────────

# Calendar sync — set a provider's pair to activate its REAL adapter (else mock):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# APPLE_CALDAV_URL=https://caldav.icloud.com
# APPLE_LIVE=1
# PUBLIC_BASE_URL=https://schedulemode.com   # builds OAuth/webhook callback URLs

# Preview gate — when PREVIEW_PASS is set, /salonflow, /sf and /api/salonflow
# require HTTP Basic auth (username defaults to "salon"). Leave unset locally.
# PREVIEW_USER=salon
# PREVIEW_PASS=
