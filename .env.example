# ── Database (verplicht) — PostgreSQL ────────────────────────────────────
# Vercel Postgres / Neon: DATABASE_URL = pooled URL, DIRECT_URL = direct URL.
# Lokaal: gebruik een gratis Neon-branch of je eigen Postgres (dan beide gelijk).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/kofferklaar?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/kofferklaar?sslmode=require

# ── Claude (verplicht) — https://console.anthropic.com ───────────────────
ANTHROPIC_API_KEY=sk-ant-api03-your_key_here

# ── Wachtwoord (verplicht zodra de app online staat) ─────────────────────
# Zonder APP_PASSWORD kan iedereen met de link je kast zien én jouw API-tegoed gebruiken.
APP_PASSWORD=

# ── Optioneel ────────────────────────────────────────────────────────────
# KOFFERKLAAR_MODEL=claude-opus-5     # model voor foto-analyse en stylist
# KOFFERKLAAR_EFFORT=medium           # low | medium | high | xhigh — hoger = grondiger maar trager
