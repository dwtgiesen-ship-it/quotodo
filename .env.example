# Supabase — create a project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Anthropic — get an API key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-your_key_here

# Resend (optional — required for "Send to Client" email feature)
# Sign up at https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# App URL — used to build public quote share links
# Local dev:   http://localhost:3000
# Production:  https://your-domain.com (set this on Vercel)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ────────────────────────────────────────────────────────────────────────
# SalonFlow (/salonflow, /sf) — ALL OPTIONAL for local testing.
# With none set, SalonFlow runs fully on SQLite with mocked integrations:
# the AI assistant falls back to rule-based; calendar sync uses a mock provider.
# ────────────────────────────────────────────────────────────────────────

# Calendar sync — set a provider's pair to activate its REAL adapter (else mock):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# APPLE_CALDAV_URL=https://caldav.icloud.com
# APPLE_LIVE=1
# PUBLIC_BASE_URL=http://localhost:3000   # builds OAuth/webhook callback URLs

# Preview gate — when PREVIEW_PASS is set, /salonflow, /sf and /api/salonflow
# require HTTP Basic auth (username defaults to "salon"). Leave unset locally.
# PREVIEW_USER=salon
# PREVIEW_PASS=

# SalonFlow database: local dev uses SQLite (prisma/schema.prisma, file:./dev.db)
# — no value needed. Production uses the Postgres+RLS schema in docs/salonflow/prisma.
